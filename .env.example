PROJECT_NAME="AptlyPilot"
API_V1_PREFIX="/api/v1"

ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

POSTGRES_DB="aptly_pilot"
POSTGRES_USER="aptly"
POSTGRES_PASSWORD="aptly"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432

DATABASE_URL="postgresql+psycopg://aptly:aptly@postgres:5432/aptly_pilot"

SECRET_KEY="change-this-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM="HS256"

REPOS_CONFIG_PATH="/app/examples/repos.yaml"

APTLY_API_URL="http://127.0.0.1:8080"